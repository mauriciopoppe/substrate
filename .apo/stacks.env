#!/usr/bin/env bash
# ==============================================================================
# APO Fleet Stacks Configuration
# Declares available GKE testbed clusters: substrate-test and substrate-test-2
# ==============================================================================

# Available Testbed Clusters
export STACK_CLUSTER_1="substrate-test"
export STACK_CLUSTER_2="substrate-test-2"

# Default target cluster (override via CLUSTER_NAME or APO stack leasing)
export CLUSTER_NAME="${CLUSTER_NAME:-substrate-test-2}"
export PROJECT_ID="${PROJECT_ID:-mauriciopoppe-gke-dev}"
export COMPUTE_REGION="${COMPUTE_REGION:-us-west1}"
export COMPUTE_ZONE="${COMPUTE_ZONE:-us-west1-c}"
export HARDWARE_TYPE="c3-standard-4"

# Quick switcher helpers
use_stack_1() {
  export CLUSTER_NAME="${STACK_CLUSTER_1}"
  echo "Switched active testbed to: ${CLUSTER_NAME}"
}

use_stack_2() {
  export CLUSTER_NAME="${STACK_CLUSTER_2}"
  echo "Switched active testbed to: ${CLUSTER_NAME}"
}

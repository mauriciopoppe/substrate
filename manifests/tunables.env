# ==============================================================================
# Agent Substrate Ingress Routing Rig Invariants (Fixed Baseline)
# ==============================================================================
# All parameters in this file represent static harness and baseline invariants.
# Optimization in this workspace targets the Go codebase (substrate/cmd/atenet/...)
# via [ACTION: CODE_REFACTOR] mutations, not manifest parameter sweeps.
# ==============================================================================

# Benchmark independent variable: Envoy proxy pinned to 2 vCPUs
# OPTUNA: name=ENVOY_CONCURRENCY, type=int, min=2, max=2, status=locked, reason=Rig CPU allocation pin
export ENVOY_CONCURRENCY=2

# Go scheduler threads: Aligned with Envoy CPU allocation to prevent CFS throttling
# OPTUNA: name=ROUTER_GOMAXPROCS, type=int, min=2, max=2, status=locked, reason=Aligned with CPU quota
export ROUTER_GOMAXPROCS=2

# Go runtime GC target: Production baseline (200% heap growth)
# OPTUNA: name=ROUTER_GOGC, type=int, min=200, max=200, status=locked, reason=Fixed GC target percentage
export ROUTER_GOGC=200

# Go runtime soft memory limit cap (1024 MiB)
# OPTUNA: name=ROUTER_GOMEMLIMIT_MIB, type=int, min=1024, max=1024, status=locked, reason=Fixed soft memory cap
export ROUTER_GOMEMLIMIT_MIB=1024

# ==============================================================================
# Feature Flags (Active Optimization Scope)
# ==============================================================================
# Add feature flags and hyperparameter tunables below to enable/disable code
# changes in substrate/cmd/atenet/internal/router/ and tune algorithmic thresholds.
# Variables prefixed with FEATURE_* are automatically synced to the atenet-router
# container as environment variables via ConfigMap atenet-router-features.
# ==============================================================================
